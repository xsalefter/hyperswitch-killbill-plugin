<FindBugsFilter>
    <!-- EI_EXPOSE_REP2: these classes store constructor-injected collaborators/records as-is
         (config handler, DAO, jOOQ record) without defensive copies. This is the standard
         Kill Bill plugin pattern (dependency injection / lightweight DTO wrapping a jOOQ
         record) and is not a real encapsulation risk here. -->
    <Match>
        <Class name="org.killbill.billing.plugin.hyperswitch.HyperswitchPaymentPluginApi"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="org.killbill.billing.plugin.hyperswitch.HyperswitchPaymentTransactionInfoPlugin"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- EQ_DOESNT_OVERRIDE_EQUALS: jOOQ-generated code under dao/gen/ (catalog, schema, table
         classes). These are regenerated from the DB schema and we do not hand-edit them, so
         we don't add equals() overrides here. -->
    <Match>
        <Class name="~org\.killbill\.billing\.plugin\.hyperswitch\.dao\.gen\..*"/>
        <Bug pattern="EQ_DOESNT_OVERRIDE_EQUALS"/>
    </Match>

    <!-- EQ_DOESNT_OVERRIDE_EQUALS: HyperswitchPaymentTransactionInfoPlugin is hand-written
         (not generated), but it's a short-lived, immutable result DTO returned from plugin
         API calls; it is never used as a map/set key or compared for equality elsewhere in
         this codebase, so omitting equals()/hashCode() is safe here. -->
    <Match>
        <Class name="org.killbill.billing.plugin.hyperswitch.HyperswitchPaymentTransactionInfoPlugin"/>
        <Bug pattern="EQ_DOESNT_OVERRIDE_EQUALS"/>
    </Match>
</FindBugsFilter>
